{
  "name": "family-agenda-routing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "routing": "node --import tsx src/main.ts",
    "legal-pages": "node --import tsx src/build-legal-pages.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src test",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm crap && pnpm mutation",
    "mutation": "stryker run",
    "crap": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json && crap-typescript --exclude .stryker-tmp/** --format text --threshold 8"
  },
  "dependencies": {
    "marked": "18.3.0",
    "nodemailer": "10.6.1",
    "pdfkit": "0.21.0",
    "pg": "8.23.1",
    "pg-boss": "12.39.0",
    "stripe": "23.2.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "2.0.2",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.8",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.15.6",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "hono": "^4.13.18",
    "mailparser": "^3.15.0",
    "smtp-server": "^3.21.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
