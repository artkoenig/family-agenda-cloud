{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "./vitest.stryker.config.ts",
    "related": false
  },
  "mutate": [
    "src/config.ts",
    "src/context.ts",
    "src/secrets.ts",
    "src/log.ts",
    "src/family-context.ts",
    "src/family-id.ts",
    "src/family-readiness.ts",
    "src/trial.ts",
    "src/due-work.ts",
    "src/failover.ts",
    "src/pool.ts",
    "src/core-answers.ts",
    "src/proxy-headers.ts",
    "src/request-routing.ts",
    "src/cli-arguments.ts",
    "src/cli-reports.ts",
    "src/landing.ts",
    "src/id-token.ts",
    "src/sign-in-cookie.ts",
    "src/cookies.ts",
    "src/routing-pages.ts",
    "src/routing-session.ts",
    "src/order-pages.ts",
    "src/order-session.ts",
    "src/post-register.ts",
    "src/legal-texts.ts",
    "src/legal-pages.ts",
    "src/legal-footer.ts",
    "src/contract-wording.ts",
    "src/contract-pages.ts",
    "src/contract-mails.ts",
    "src/checkout-texts.ts",
    "src/confirmation-mail.ts",
    "src/invitation-mail.ts",
    "src/mail-card.ts",
    "src/outbox-policy.ts",
    "src/health-rules.ts",
    "src/health-mask.ts",
    "src/health-check.ts",
    "src/health-mail.ts"
  ],
  "timeoutMS": 60000,
  "concurrency": 4,
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "tempDirName": ".stryker-tmp",
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "thresholds": {
    "high": 95,
    "low": 75,
    "break": 75
  }
}
