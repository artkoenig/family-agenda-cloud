# Starts the health check every 5 minutes, and after a boot. healthchecks.io expects its ping every
# 5 minutes, with a grace of 5 (docs/runbook/setup.md, "The health check").
[Unit]
Description=Family Agenda health check every 5 minutes

[Timer]
# The first run a minute after the timer starts (a deploy, a boot), then 5 minutes after the last.
OnActiveSec=1min
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
