family-agenda.cloud {
	encode zstd gzip

	root * /srv/site
	# One URL per page for search engines: /impressum.html → /impressum, /index.html and
	# /en/index.html → their folder. In a route, so the redirects run before try_files rewrites to .html.
	# The legal pages, built from site/legal/ (routing/src/legal-pages.ts), at their paths without
	# .html: /impressum is site/impressum.html, /en/imprint is site/en/imprint.html.
	route {
		@index path_regexp index ^(.*/)index\.html$
		redir @index {re.index.1} 301
		@html path_regexp html ^(/.+)\.html$
		redir @html {re.html.1} 301
		try_files {path} {path}.html
		file_server
	}
}

# Every Family, at app.family-agenda.cloud/<Family id>/, through the Router to a core of the pool.
# The Router answers an unknown Family 404 and takes the client's address and scheme from Caddy's
# X-Forwarded-* headers (TRUST_PROXY).
app.family-agenda.cloud {
	encode zstd gzip

	# Until launch.
	header X-Robots-Tag "noindex, nofollow"

	# The landing page's design system for central sign-in's pages (routing/src/sign-in-pages.ts):
	# only its stylesheets and fonts, open before launch too. Family ids are UUIDs, so /design is free.
	@design path /design/tokens.css /design/design.css /design/fonts/*
	handle @design {
		uri strip_prefix /design
		root * /srv/site
		file_server
	}

	handle {
		reverse_proxy router:8080
	}
}

# Logto's sign-in and registration pages, its OIDC endpoints and its Management API, for every
# Family. The admin console is not here: it listens on the Cube's loopback alone.
auth.family-agenda.cloud {
	encode zstd gzip

	# Until launch.
	header X-Robots-Tag "noindex, nofollow"

	reverse_proxy logto:3001
}
