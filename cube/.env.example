# Keys of /opt/family-agenda/.env on the Cube (root only, mode 600). Values live in the password manager.
# Single quotes keep Compose from reading the "$" of a bcrypt hash as a variable.

# Basic Auth in front of the landing page until launch.
# Hash: docker run --rm caddy:2.11.9 caddy hash-password --plaintext '<password>'
LANDING_BASIC_AUTH_USER=
LANDING_BASIC_AUTH_HASH=''

# The Routing module (routing/). Each key: openssl rand -base64 32
# Wraps every family key and Family database password in the Directory; never stored in it.
OPERATOR_KEY=
# Encrypts and signs the Contexts the cores open; the cores get the same value. 32 characters or more.
CONTEXT_KEY=
# The bearer token of the cores' trigger port (due work, purge, sweep); the cores get
# the same value. 32 characters or more.
TRIGGER_TOKEN=
# The Routing module's role on Postgres, which owns the Directory and creates the Families' databases and roles.
DIRECTORY_DATABASE_PASSWORD=
# Signs the Tickets of the cores' plugin calls, which the plugins' Egress Proxies check; the cores
# and the proxies get the same value. At least 32 characters: openssl rand -base64 32
EGRESS_TICKET_KEY=
# Signs the cores' family.created to the receiver; the cores get the same value. At least 32
# characters: openssl rand -base64 32
FAMILY_WEBHOOK_SECRET=
# The cores' role on Postgres for the shared registration database. In a URL, so hex only:
# openssl rand -hex 32
REGISTRATION_DATABASE_PASSWORD=

# Logto, the one Identity Provider of every Family, at auth.family-agenda.cloud (docs/runbook/setup.md, "Logto").
# Its role on Postgres, which owns Logto's database. In a URL, so hex only: openssl rand -hex 32
LOGTO_DATABASE_PASSWORD=
# The Traditional Web application "Family Agenda" the cores sign in with: its ID and secret.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The Machine-to-Machine application with the Management API role, which the cores create the
# Organizations with and `routing delete` deletes them with: its ID and secret.
IDP_MANAGEMENT_CLIENT_ID=
IDP_MANAGEMENT_CLIENT_SECRET=
# The signing key of the PostRegister webhook to http://router:8080/idp/events; central sign-in signs
# a lost PostRegister it sends the cores again with it.
IDP_WEBHOOK_SECRET=
# The Google OAuth client of Logto's Google connector (docs/runbook/setup.md, "Google sign-in"). Optional:
# empty, the sign-in screen offers no Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Whether anyone may register at Logto: open or closed, closed unless set. Deploying sets it
# (`routing sign-in-experience`); closed, invitation links still create the invitee's account.
# Opened at gate 13b of docs/launch-checklist.md (docs/runbook/setup.md, "Opening and closing registration").
REGISTRATION=closed

# The mail server the Routing module's mail sender sends its mails through (`mail-sender`, #233): the
# password of the no-reply@family-agenda.cloud mailbox at IONOS (docs/runbook/setup.md, step 5), the
# same as Logto's SMTP connector's. Only the mail-sender service gets it.
SMTP_PASSWORD=
# Optional: another mail server (SMTP with implicit TLS), such as Scaleway TEM's (docs/runbook/families.md,
# "The mail outbox"). Unset, the IONOS mailbox: smtp.ionos.de, 465, no-reply@family-agenda.cloud.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=

# The Object Storage bucket of the Families' blobs (Frankfurt, docs/runbook/setup.md, "Object Storage"),
# which the blob-mount service mounts for the cores: its name, and the access key and secret of the
# service's Object Storage key.
BLOB_BUCKET=
BLOB_BUCKET_ACCESS_KEY=
BLOB_BUCKET_SECRET_KEY=

# Extraction through the IONOS AI Model Hub (docs/runbook/setup.md, step 6): the token, without
# trailing whitespace. It expires; renew it before.
LLM_API_KEY=
# The model; Qwen/Qwen3.8-27B unless set. Optional, and no secret. openai/gpt-oss-120b is the one
# other model documented to accept the core's reasoning_effort "low".
# LLM_MODEL=Qwen/Qwen3.8-27B

# How many cores the pool has; two unless set. Optional, and no secret. To scale the pool, see
# docs/runbook/setup.md, "Scaling the pool of cores".
# CORE_REPLICAS=2
