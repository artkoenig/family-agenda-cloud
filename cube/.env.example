# Keys of /opt/family-agenda/.env on the Cube (root only, mode 600). Values live in the password manager.
# Single quotes keep Compose from reading the "$" of a bcrypt hash as a variable.

# Basic Auth in front of the landing page until launch.
# Hash: docker run --rm caddy:2.11.9 caddy hash-password --plaintext '<password>'
LANDING_BASIC_AUTH_USER=
LANDING_BASIC_AUTH_HASH=''

# The Routing module (routing/). Each key: openssl rand -base64 32
# Wraps every family key and Family database password in the Directory; never stored in it.
OPERATOR_KEY=
# Encrypts and signs the Contexts the cores open; the cores get the same value. 32 characters or more.
CONTEXT_KEY=
# The bearer token of the cores' trigger port (due work, Admin passwords); the cores get
# the same value. 32 characters or more.
TRIGGER_TOKEN=
# The Routing module's role on Postgres, which owns the Directory and creates the Families' databases and roles.
DIRECTORY_DATABASE_PASSWORD=
# Signs the Tickets of the cores' plugin calls, which the plugins' Egress Proxies check; the cores
# and the proxies get the same value. At least 32 characters: openssl rand -base64 32
EGRESS_TICKET_KEY=

# The Object Storage bucket of the Families' blobs (Frankfurt, docs/runbook/setup.md, "Object Storage"),
# which the blob-mount service mounts for the cores: its name, and the access key and secret of the
# service's Object Storage key.
BLOB_BUCKET=
BLOB_BUCKET_ACCESS_KEY=
BLOB_BUCKET_SECRET_KEY=

# How many cores the pool has; two unless set. Optional, and no secret. To scale the pool, see
# docs/runbook/setup.md, "Scaling the pool of cores".
# CORE_REPLICAS=2
